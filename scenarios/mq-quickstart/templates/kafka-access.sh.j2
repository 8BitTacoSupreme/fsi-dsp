#!/usr/bin/env bash
# =============================================================================
# GATED: for the Kafka platform team. This kit never runs it.
# =============================================================================
# What the Connect on Z worker on {{ inventory_hostname }} needs on the Confluent
# Platform cluster, as {{ 'RBAC role bindings (Confluent CLI against MDS)' if cp_authorizer == 'rbac' else 'ACLs (kafka-acls)' }}.
# Review it, then run it as a cluster administrator.
#
# The worker and the connectors share one principal (the kit sets no
# per-connector client overrides), so {{ kafka_client_principal }} needs:
#   - the Connect group and its three internal topics
#   - the _confluent-command license topic (describe, read, write)
#   - write on the source topic {{ mq_source_topic }}
{% if mq_sink_enabled | bool %}
#   - read on the sink topic {{ mq_sink_topic }} and its group connect-{{ mq_sink_connector_name }}
{% endif %}
# Sources: Confluent "Configure RBAC for a Connect Cluster" and "Kafka Connect
# Security Basics" (worker, connector and license topic ACL requirements).
# Generated by fsi-dsp scenarios/mq-quickstart; re-run the build to change it.
# =============================================================================
set -euo pipefail

PRINCIPAL={{ kafka_client_principal | quote }}
{% if cp_authorizer == 'rbac' %}
: "${MDS_URL:?set MDS_URL to the Metadata Service URL and run confluent login --url against it first}"
KAFKA_CLUSTER_ID={{ cp_kafka_cluster_id | quote }}

bind() {
  confluent iam rbac role-binding create --principal "${PRINCIPAL}" --role "$1" \
    --resource "$2" --kafka-cluster "${KAFKA_CLUSTER_ID}"
}

# ResourceOwner covers creating the internal topics if Connect has to.
bind ResourceOwner {{ ('Group:' ~ connect_group_id) | quote }}
bind ResourceOwner {{ ('Topic:' ~ connect_config_topic) | quote }}
bind ResourceOwner {{ ('Topic:' ~ connect_offset_topic) | quote }}
bind ResourceOwner {{ ('Topic:' ~ connect_status_topic) | quote }}
bind DeveloperRead Topic:_confluent-command
bind DeveloperWrite Topic:_confluent-command
bind DeveloperWrite {{ ('Topic:' ~ mq_source_topic) | quote }}
{% if mq_sink_enabled | bool %}
bind DeveloperRead {{ ('Topic:' ~ mq_sink_topic) | quote }}
bind DeveloperRead {{ ('Group:connect-' ~ mq_sink_connector_name) | quote }}
{% endif %}
{% else %}
: "${BOOTSTRAP:?set BOOTSTRAP to a broker listener the admin client can reach}"
: "${ADMIN_CONFIG:?set ADMIN_CONFIG to the admin client properties file}"

acl() {
  kafka-acls --bootstrap-server "${BOOTSTRAP}" --command-config "${ADMIN_CONFIG}" \
    --add --allow-principal "${PRINCIPAL}" "$@"
}

acl --operation Read --group {{ connect_group_id | quote }}
# Create only matters if Connect creates its internal topics. Kafka authorizes
# CreateTopics on the topic resource (KIP-277), so no cluster-wide Create.
acl --operation Create --operation Read --operation Write --topic {{ connect_config_topic | quote }}
acl --operation Create --operation Read --operation Write --topic {{ connect_offset_topic | quote }}
acl --operation Create --operation Read --operation Write --topic {{ connect_status_topic | quote }}
acl --operation Describe --operation Read --operation Write --topic _confluent-command
acl --operation Write --topic {{ mq_source_topic | quote }}
{% if mq_sink_enabled | bool %}
acl --operation Read --topic {{ mq_sink_topic | quote }}
acl --operation Read --group {{ ('connect-' ~ mq_sink_connector_name) | quote }}
{% endif %}
{% endif %}
