# =============================================================================
# Kafka Connect on Z -- distributed worker ({{ stc_name }})
# =============================================================================
# Generated by fsi-dsp scenarios/mq-quickstart. Change inputs.yml and re-run;
# hand edits are overwritten.
#
# Java .properties files have no inline comments: everything after '=' is the
# value. Every comment here is on its own line for that reason.
# Uploaded as {{ connect_props_encoding }} (Confluent Connect on z/OS converts
# .properties to IBM-1047).
# =============================================================================
{#
  One settings block per prefix: kafka_client_security for each Kafka client
  prefix, connect_rest_listener_ssl for the REST listener (vars/derived.yml).
  Backslashes are doubled because Java .properties treats them as escapes.
#}
{% macro props_block(settings, prefix) %}
{% for key, value in settings.items() %}
{{ prefix }}{{ key }}={{ value | string | replace('\\', '\\\\') }}
{% endfor %}
{% endmacro %}

# --- Worker connection to {{ 'Confluent Platform (mTLS)' if (cp_target | bool) else 'Confluent Cloud (API key)' }}
bootstrap.servers={{ kafka_bootstrap }}
{{ props_block(kafka_client_security, '') -}}
client.dns.lookup=use_all_dns_ips

# --- Connector producers (MQ source) -----------------------------------------
# Connect gives connector producers and consumers only their prefixed settings
# (Kafka 4.1 Worker), so the security block is repeated for each.
# acks/idempotence/lz4 are the FSI producer canon.
{{ props_block(kafka_client_security, 'producer.') -}}
producer.client.dns.lookup=use_all_dns_ips
producer.acks=all
producer.enable.idempotence=true
producer.compression.type=lz4

# --- Connector consumers (MQ sink) -------------------------------------------
{{ props_block(kafka_client_security, 'consumer.') -}}
consumer.client.dns.lookup=use_all_dns_ips

# --- Distributed coordination ------------------------------------------------
# Internal topics at RF 3 (Confluent Cloud requires it; on Confluent Platform it
# needs at least 3 brokers). The config topic is always one partition, so it
# has no partitions setting.
group.id={{ connect_group_id }}
config.storage.topic={{ connect_config_topic }}
config.storage.replication.factor=3
offset.storage.topic={{ connect_offset_topic }}
offset.storage.replication.factor=3
offset.storage.partitions=25
status.storage.topic={{ connect_status_topic }}
status.storage.replication.factor=3
status.storage.partitions=5

# --- Converters --------------------------------------------------------------
key.converter={{ connect_key_converter }}
value.converter={{ connect_value_converter }}

# --- Plugins -----------------------------------------------------------------
# The only setting Connect reads for plugins. KAFKA_CONNECT_PLUGINS (in the
# guide) is not read by anything.
plugin.path={{ connect_plugins_dir }}

# --- REST API ----------------------------------------------------------------
# rest.port was removed in Apache Kafka 3.0 and is silently ignored, so the
# guide's rest.port=8082 left the worker on the default 8083.
{% if connect_rest_mtls | bool %}
# HTTPS, client certificate required. The listeners.https. settings are the
# REST listener's own stores: unprefixed, it would reuse this worker's ssl.*
# (the Kafka client keystore on Confluent Platform). Once any prefixed setting
# is present the unprefixed ones are ignored, so the set is complete.
listeners=https://0.0.0.0:{{ connect_rest_port }}
rest.advertised.listener=https
rest.advertised.host.name={{ connect_rest_host }}
rest.advertised.port={{ connect_rest_port }}
{{ props_block(connect_rest_listener_ssl, 'listeners.https.') -}}
{% else %}
listeners=http://0.0.0.0:{{ connect_rest_port }}
rest.advertised.host.name={{ connect_rest_host }}
rest.advertised.port={{ connect_rest_port }}
{% endif %}
